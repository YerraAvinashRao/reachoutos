# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
# Required for PostgreSQL database persistence and Supabase Auth.
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_ANON_KEY: The public anonymous API key for your Supabase project.
# Used for client-side authentication and standard RLS-gated requests.
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: The secret service-role key for server-side privileged operations.
# NEVER expose this key to the browser or frontend bundle.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# DATABASE_URL: Direct PostgreSQL connection string for running migrations (e.g., psql / drizzle / pg)
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

